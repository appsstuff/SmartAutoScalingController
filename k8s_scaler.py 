from kubernetes import client, config
import os

# Load kubeconfig (either incluster or local)
try:
    config.load_incluster_config()
except Exception:
    config.load_kube_config()

v1 = client.AppsV1Api()
core_v1 = client.CoreV1Api()

def apply_k8s_scaling(pod_name, namespace, decision):
    """
    Applies Kubernetes scaling based on hybrid model decision
    """
    try:
        # Get deployment info
        dep = v1.read_namespaced_deployment(name=pod_name, namespace=namespace)
        current_reps = dep.spec.replicas
        min_reps = int(os.getenv("MIN_REPLICAS", "2"))
        max_reps = int(os.getenv("MAX_REPLICAS", "10"))
        step = int(os.getenv("SCALING_STEP", "1"))

        print(f" Current replicas for {pod_name}: {current_reps}")

        if decision == "scale_up":
            new_reps = min(current_reps + step, max_reps)
            print(f" Scaling up → {new_reps}")
        elif decision == "scale_down":
            new_reps = max(current_reps - step, min_reps)
            print(f" Scaling down → {new_reps}")
        else:
            new_reps = current_reps
            print(f"No change needed")

        # Apply patch
        if new_reps != current_reps:
            v1.patch_namespaced_deployment_scale(
                name=pod_name,
                namespace=namespace,
                body={"spec": {"replicas": new_reps}}
            )
            print(f"Replicas updated to {new_reps}")
        else:
            print(f" No change in replica count")
    
    except client.rest.ApiException as e:
        print(f" Kubernetes API error: {e.reason}")
    except Exception as e:
        print(f" Error during scaling: {e}")